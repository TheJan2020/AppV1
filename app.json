{
  "expo": {
    "name": "Primewave",
    "slug": "ha-app",
    "version": "1.1.1",
    "orientation": "default",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#09091A",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "ai.primewave.app",
      "buildNumber": "81",
      "supportsTablet": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Primewave needs the microphone to talk with Butler, your voice assistant.",
        "NSLocalNetworkUsageDescription": "Primewave needs to reach your Butler voice server and Home Assistant on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Primewave uses Face ID so you can unlock the app securely without typing your password.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#4B2FA8"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "ai.primewave.app"
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "scheme": "ha-app",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Primewave needs the microphone to talk with Butler, your voice assistant."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon.png",
          "color": "#832ea9",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60d12dc4-39fe-4c9b-a456-13111390c3fc"
      }
    },
    "owner": "uzairkhan-12"
  }
}
